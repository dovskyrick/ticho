rules_version = '2';

// Public can VIEW images. Only admins can upload / delete.
// Uploads limited to images under 10 MB.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_TICHO_UID', 'REPLACE_WITH_YOUR_UID'];
    }

    match /{folder}/{fileName} {
      allow read: if folder in ['gigs', 'about'];
      allow delete: if isAdmin() && folder in ['gigs', 'about'];
      allow create, update: if isAdmin()
        && folder in ['gigs', 'about']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
