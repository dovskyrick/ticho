rules_version = '2';

// Public can READ everything the site shows.
// Only the admin accounts listed below can WRITE.
// Admins: ticho = qnnaZo…, ricardo = DqY229…
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['qnnaZoRlbcb57tbtiGBjbjLGSLP2', 'DqY229bBNnT9WAVL2hzAzsl5paG3'];
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
