rules_version = '2';

// Public can READ everything the site shows.
// Only the admin accounts listed below can WRITE.
// Replace the UIDs after creating the users (see docs/HIL-firebase-setup.md, step 5).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['REPLACE_WITH_TICHO_UID', 'REPLACE_WITH_YOUR_UID'];
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
